<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1100.0" stylesheets="@../css/styles.css"
           style="-fx-background-color: #0B0F19;"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.dreamstop.controller.LoginController">

    <children>
        <!-- Background subtle glow shapes -->
        <VBox alignment="CENTER" spacing="20.0">
            <!-- Center Auth Card -->
            <VBox maxWidth="440.0" spacing="18.0"
                  style="-fx-background-color: #131B2E; -fx-background-radius: 20px; -fx-padding: 36px 32px; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.5), 24, 0, 0, 8); -fx-border-color: #1E293B; -fx-border-radius: 20px; -fx-border-width: 1.5px;">
                <children>

                    <!-- Brand Header -->
                    <VBox alignment="CENTER" spacing="6.0">
                        <children>
                            <StackPane fx:id="loginLogoBox" prefHeight="54.0" prefWidth="54.0" maxWidth="54.0" />
                            <Label text="DreamsTop" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;" />
                            <Label text="i-Wish Gaming &amp; Social Platform" style="-fx-text-fill: #94A3B8; -fx-font-size: 13px;" />
                        </children>
                    </VBox>

                    <!-- Mode Toggle Tabs (Sign In vs Register) -->
                    <HBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #0F172A; -fx-background-radius: 12px; -fx-padding: 4px;">
                        <children>
                            <Button fx:id="btnTabSignIn" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#handleSwitchToSignIn"
                                    text="Sign In" style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8px; -fx-cursor: hand;" />
                            <Button fx:id="btnTabRegister" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#handleSwitchToRegister"
                                    text="Create Account" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8px; -fx-cursor: hand;" />
                        </children>
                    </HBox>

                    <!-- Form Inputs -->
                    <VBox spacing="14.0">
                        <children>
                            <!-- Username / Email Field -->
                            <VBox spacing="6.0">
                                <children>
                                    <Label text="Username or Email" style="-fx-text-fill: #CBD5E1; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                    <TextField fx:id="txtUsername" promptText="Enter your username"
                                               style="-fx-background-color: #0F172A; -fx-text-fill: white; -fx-prompt-text-fill: #64748B; -fx-background-radius: 10px; -fx-border-color: #334155; -fx-border-radius: 10px; -fx-padding: 11px 14px; -fx-font-size: 13px;" />
                                </children>
                            </VBox>

                            <!-- Email Field (Register Only) -->
                            <VBox fx:id="boxEmail" managed="false" visible="false" spacing="6.0">
                                <children>
                                    <Label text="Email Address" style="-fx-text-fill: #CBD5E1; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                    <TextField fx:id="txtEmail" promptText="e.g. gamer@dreamstop.com"
                                               style="-fx-background-color: #0F172A; -fx-text-fill: white; -fx-prompt-text-fill: #64748B; -fx-background-radius: 10px; -fx-border-color: #334155; -fx-border-radius: 10px; -fx-padding: 11px 14px; -fx-font-size: 13px;" />
                                </children>
                            </VBox>

                            <!-- Password Field -->
                            <VBox spacing="6.0">
                                <children>
                                    <Label text="Password" style="-fx-text-fill: #CBD5E1; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                    <PasswordField fx:id="txtPassword" promptText="••••••••"
                                                   onAction="#handlePrimaryAction"
                                                   style="-fx-background-color: #0F172A; -fx-text-fill: white; -fx-prompt-text-fill: #64748B; -fx-background-radius: 10px; -fx-border-color: #334155; -fx-border-radius: 10px; -fx-padding: 11px 14px; -fx-font-size: 13px;" />
                                </children>
                            </VBox>
                        </children>
                    </VBox>

                    <!-- Error / Status Message -->
                    <Label fx:id="lblMessage" wrapText="true" managed="false" visible="false"
                           style="-fx-text-fill: #EF4444; -fx-font-size: 12px; -fx-font-weight: bold;" />

                    <!-- Primary Action Button (Sign In / Register) -->
                    <Button fx:id="btnPrimaryAction" maxWidth="Infinity" onAction="#handlePrimaryAction"
                            text="Sign In to DreamsTop"
                            style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10px; -fx-padding: 12px; -fx-cursor: hand;" />

                    <!-- Divider -->
                    <HBox alignment="CENTER" spacing="10.0">
                        <children>
                            <Separator HBox.hgrow="ALWAYS" style="-fx-background-color: #1E293B;" />
                            <Label text="QUICK SIGN-IN" style="-fx-text-fill: #64748B; -fx-font-size: 10px; -fx-font-weight: bold;" />
                            <Separator HBox.hgrow="ALWAYS" style="-fx-background-color: #1E293B;" />
                        </children>
                    </HBox>

                    <!-- Quick Demo Accounts -->
                    <HBox alignment="CENTER" spacing="8.0">
                        <children>
                            <Button onAction="#handleQuickLoginKady" text="👑 Mohamed" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    style="-fx-background-color: #1E293B; -fx-text-fill: #10B981; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8px; -fx-cursor: hand;" />
                            <Button onAction="#handleQuickLoginYousef" text="🎮 Yousef" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    style="-fx-background-color: #1E293B; -fx-text-fill: #6366F1; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8px; -fx-cursor: hand;" />
                            <Button onAction="#handleQuickLoginAdham" text="⚡ Adham" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    style="-fx-background-color: #1E293B; -fx-text-fill: #F59E0B; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8px; -fx-cursor: hand;" />
                        </children>
                    </HBox>

                    <!-- Server Connection Indicator -->
                    <HBox alignment="CENTER" spacing="6.0">
                        <children>
                            <Label fx:id="lblStatusDot" text="●" style="-fx-text-fill: #10B981; -fx-font-size: 10px;" />
                            <Label fx:id="lblServerStatus" text="Connected to Server (127.0.0.1:5005)" style="-fx-text-fill: #64748B; -fx-font-size: 11px;" />
                        </children>
                    </HBox>

                </children>
            </VBox>
        </VBox>

        <!-- Toast Notifications Overlay -->
        <StackPane fx:id="toastOverlay" mouseTransparent="true" pickOnBounds="false" />
    </children>
</StackPane>
